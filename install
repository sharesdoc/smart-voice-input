#!/usr/bin/env bash
#===============================================================================
# install  —  VoiceInput（macOS AI 智能语音输入）安装/生命周期脚本
# 生成自 write-install-shell skill
#
# 形态：Python 桌面菜单栏应用（从源码运行 + nohup 后台 + conda base）。
# 本应用无监听端口、无数据库/Docker；-p/--port 选项仅为规范保留，对本应用无效。
#===============================================================================

# PORT 变量为兼容统一选项规范(-p/--port)而保留；本桌面应用无监听端口，故不被使用
# shellcheck disable=SC2034
set -Euo pipefail

#===============================================================================
# 元数据
#===============================================================================
NAME="voiceinput"
SCRIPT_VERSION="1.0.0"
DEFAULT_PORT="0"            # 本应用无监听端口；保留以兼容统一选项规范
DEFAULT_PROFILE="loc"      # 唯一 profile；-b 默认使用

#===============================================================================
# 路径与命名空间
#===============================================================================
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"

BUILD_CFG_FILE="$PROJECT_DIR/build-configuration"
INSTALL_CFG_FILE="$PROJECT_DIR/.install.cfg"
PID_FILE="$PROJECT_DIR/.install-${NAME}.pid"
LOG_DIR="$PROJECT_DIR/log"
INSTALL_LOG="$LOG_DIR/install.log"
MAIN_LOG_FILE="$LOG_DIR/${NAME}.log"   # nohup 启动的运行输出

# 应用运行时数据（由 voiceinput 自身使用）
APP_SUPPORT_DIR="$HOME/Library/Application Support/VoiceInput"
APP_LOG_DIR="$HOME/Library/Logs/VoiceInput"
APP_LOG_FILE="$APP_LOG_DIR/voiceinput.log"   # 应用结构化日志(详细链路,菜单"查看日志"同一份)

#===============================================================================
# 颜色（非 TTY 自动关闭）
#===============================================================================
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$(printf '\033[0;31m'); GREEN=$(printf '\033[0;32m')
    YELLOW=$(printf '\033[1;33m'); BLUE=$(printf '\033[0;34m')
    BOLD=$(printf '\033[1m'); NC=$(printf '\033[0m')
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; BOLD=""; NC=""
fi

log_info()  { printf "%s[INFO]%s %s\n"  "$GREEN"  "$NC" "$*" | tee -a "$INSTALL_LOG" >&2; }
log_warn()  { printf "%s[WARN]%s %s\n"  "$YELLOW" "$NC" "$*" | tee -a "$INSTALL_LOG" >&2; }
log_error() { printf "%s[ERROR]%s %s\n" "$RED"    "$NC" "$*" | tee -a "$INSTALL_LOG" >&2; }
log_title() { printf "\n%s%s▶ %s%s\n"   "$BLUE" "$BOLD" "$*" "$NC" | tee -a "$INSTALL_LOG" >&2; }

#===============================================================================
# 目录与配置
#===============================================================================
ensure_dirs() {
    mkdir -p "$LOG_DIR"
    touch "$INSTALL_LOG"
}

load_install_cfg() {
    PORT="$DEFAULT_PORT"
    PROFILE="$DEFAULT_PROFILE"
    PYTHON_BIN="$HOME/ins/miniconda/bin/python"
    WHISPER_MODEL="small"
    LLM_MODE="ollama"
    OLLAMA_MODEL="qwen2.5:7b-instruct-q4_K_M"
    INSTALLED_AT=""
    INSTALLED_VERSION=""
    if [ -f "$INSTALL_CFG_FILE" ]; then
        # shellcheck disable=SC1090
        source "$INSTALL_CFG_FILE"
    fi
}

write_install_cfg() {
    cat > "$INSTALL_CFG_FILE" <<EOF
# Auto-generated by ./install (VoiceInput); do not edit manually
NAME=${NAME}
PROFILE=${PROFILE}
PYTHON_BIN=${PYTHON_BIN}
WHISPER_MODEL=${WHISPER_MODEL}
LLM_MODE=${LLM_MODE}
OLLAMA_MODEL=${OLLAMA_MODEL}
MAIN_LOG_FILE=${MAIN_LOG_FILE}
INSTALLED_AT=${INSTALLED_AT:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}
INSTALLED_VERSION=${INSTALLED_VERSION:-$SCRIPT_VERSION}
EOF
}

load_build_config() {
    # 加载基础配置，再叠加 loc profile（唯一环境）
    [ -f "$BUILD_CFG_FILE" ] || { log_error "未找到 $BUILD_CFG_FILE"; exit 2; }
    # shellcheck disable=SC1090
    source "$BUILD_CFG_FILE"
    local profile_file="$BUILD_CFG_FILE.loc"
    [ -f "$profile_file" ] || { log_error "未找到 $profile_file"; exit 2; }
    # shellcheck disable=SC1090
    source "$profile_file"
    PROFILE="loc"
}

#===============================================================================
# 工具函数
#===============================================================================
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid; pid=$(cat "$PID_FILE" 2>/dev/null || true)
        [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && return 0
    fi
    # 兜底：检测任何 `python -m voiceinput` 实例（含非本脚本启动的）
    pgrep -f "[-]m voiceinput" >/dev/null 2>&1 && return 0
    return 1
}

# 列出所有 voiceinput 应用进程 PID（空格分隔）
voiceinput_pids() {
    pgrep -f "[-]m voiceinput" 2>/dev/null | tr '\n' ' '
}

assert_port() {
    local p="$1"
    [[ "$p" =~ ^[0-9]+$ ]] || { log_error "端口必须是整数: $p"; exit 2; }
}

safe_rm() {
    local target="$1"
    [ -n "$target" ] || { log_error "safe_rm: 路径为空"; return 1; }
    case "$target" in
        / | "$HOME" | "$HOME/" | "" )
            log_error "safe_rm: 拒绝删除危险路径: $target"; return 1 ;;
    esac
    rm -rf -- "$target"
}

confirm_yes() {
    local prompt="$1"
    printf "%s " "$prompt"
    local ans; read -r ans
    [ "$ans" = "yes" ]
}

require_python() {
    if [ ! -x "$PYTHON_BIN" ]; then
        log_error "未找到 Python 解释器: ${PYTHON_BIN}（请确认 conda base 已安装）"
        exit 3
    fi
}

# 检测操作系统与 CPU 架构（同时支持 Intel x86_64 与 Apple Silicon arm64）
detect_env() {
    local os arch pyarch
    os="$(uname -s)"
    arch="$(uname -m)"          # arm64 | x86_64
    log_info "运行环境: ${os} ${arch}"
    if [ "$os" != "Darwin" ]; then
        log_warn "本程序面向 macOS；当前为 ${os}，可能无法正常运行。"
    fi
    # Python 解释器架构（Python 本身不管，仅核对架构是否与系统一致）
    pyarch="$("$PYTHON_BIN" -c 'import platform;print(platform.machine())' 2>/dev/null || echo '?')"
    log_info "Python 解释器架构: ${pyarch}"
    if [ "$pyarch" != "?" ] && [ "$pyarch" != "$arch" ]; then
        log_warn "Python 架构(${pyarch}) 与系统(${arch}) 不一致(可能在 Rosetta 下)，建议用原生架构 Python。"
    fi
    if [ "$arch" = "arm64" ]; then
        log_info "Apple Silicon：可用引擎 = MLX Whisper(Apple加速) / SenseVoice / faster-whisper / 阿里Fun-ASR / 在线"
    else
        log_warn "Intel(x86_64)：MLX Whisper 不可用(仅 Apple Silicon)；可用 = faster-whisper / SenseVoice / 阿里Fun-ASR / 在线"
    fi
}

ollama_reachable() {
    local url="http://localhost:11434/api/tags"
    command -v curl >/dev/null 2>&1 || return 1
    curl -fsS --max-time 3 "$url" >/dev/null 2>&1
}

#===============================================================================
# 业务命令
#===============================================================================

cmd_build() {
    log_title "Build / 校验 (profile=loc)"
    load_build_config
    require_python
    detect_env   # 检测系统架构(Intel/ARM)与可用引擎

    # 从源码运行：构建=语法编译校验 + （可选）单元测试
    log_info "py_compile 校验所有模块…"
    "$PYTHON_BIN" -m py_compile "$PROJECT_DIR"/voiceinput/*.py \
        || { log_error "语法编译失败"; exit 1; }

    if [ "${RUN_TESTS_ON_BUILD:-1}" = "1" ]; then
        if "$PYTHON_BIN" -m pytest --version >/dev/null 2>&1; then
            log_info "运行单元测试…"
            # 覆盖率回归门禁（J-P3-01）：仅当配置 COV_FAIL_UNDER 且装了 pytest-cov 才启用
            local cov_args=()
            if [ -n "${COV_FAIL_UNDER:-}" ]; then
                if "$PYTHON_BIN" -c "import pytest_cov" >/dev/null 2>&1; then
                    log_info "启用覆盖率回归门禁：--cov-fail-under=${COV_FAIL_UNDER}"
                    cov_args=(--cov=voiceinput "--cov-fail-under=${COV_FAIL_UNDER}")
                else
                    log_warn "未安装 pytest-cov，跳过覆盖率门禁（pip install pytest pytest-cov 可启用）"
                fi
            fi
            # bash 3.2 安全：空数组在 set -u 下用 ${arr[@]+"${arr[@]}"} 展开
            ( cd "$PROJECT_DIR" && "$PYTHON_BIN" -m pytest tests/ -q \
                ${cov_args[@]+"${cov_args[@]}"} ) \
                || { log_error "单元测试未通过（或覆盖率低于门禁 ${COV_FAIL_UNDER:-}）"; exit 1; }
        else
            log_warn "未安装 pytest，跳过测试（可先执行 -i）"
        fi
    fi
    log_info "校验通过。profile=loc WHISPER_MODEL=${WHISPER_MODEL} LLM_MODE=${LLM_MODE}"
}

# ---- 按需安装：引擎 key ↔ 配置名/依赖文件/是否需下载本地模型 的映射 ----
# 引擎 key：fw=faster-whisper  sv=SenseVoice  mlx=MLX  ds=阿里在线  on=OpenAI兼容在线
engine_config_name() {           # key → voiceinput 配置里的 asr.engine 取值
    case "$1" in
        fw)  echo "whisper_local" ;;
        sv)  echo "sensevoice" ;;
        mlx) echo "mlx_whisper" ;;
        ds)  echo "dashscope" ;;
        on)  echo "online" ;;
    esac
}
engine_req_file() {              # key → requirements 分组文件（on 复用 base，无单独文件）
    case "$1" in
        fw)  echo "requirements/asr-faster-whisper.txt" ;;
        sv)  echo "requirements/asr-sensevoice.txt" ;;
        mlx) echo "requirements/asr-mlx.txt" ;;
        ds)  echo "requirements/asr-online.txt" ;;
        on)  echo "" ;;
    esac
}
engine_needs_model() {           # key → 是否需要预下载本地模型（在线引擎不需要）
    case "$1" in
        fw|sv|mlx) return 0 ;;
        *) return 1 ;;
    esac
}

# 交互选择 ASR 引擎（可多选）；结果写入全局数组 SEL_ENGINES（引擎 key）
prompt_asr_engines() {
    local arch="$1"
    log_title "① 选择要安装的 ASR 语音识别引擎（可多选）"
    printf "  1) faster-whisper   本地 Whisper，跨平台，%s无需 PyTorch%s（推荐）\n" "$BOLD" "$NC" >&2
    printf "  2) SenseVoice       本地极速·自带标点；%s需 PyTorch，体积最大%s\n" "$YELLOW" "$NC" >&2
    if [ "$arch" = "arm64" ]; then
        printf "  3) MLX Whisper      Apple Silicon 加速（仅 arm64）\n" >&2
    else
        printf "  3) MLX Whisper      %s（不可用：仅 Apple Silicon）%s\n" "$YELLOW" "$NC" >&2
    fi
    printf "  4) 阿里云在线        DashScope Fun-ASR，%s最轻量·无 PyTorch%s（需 API Key）\n" "$GREEN" "$NC" >&2
    printf "  5) OpenAI 兼容在线   Whisper API，%s无需额外依赖%s（需 API Key）\n" "$GREEN" "$NC" >&2
    printf "  6) %s安装全部%s          安装以上所有可用引擎\n" "$BOLD" "$NC" >&2
    printf "%s请输入编号（空格分隔可多选，如 '1 3' 或 '2 4 5'），回车默认 1: %s" "$BOLD" "$NC" >&2
    local ans; read -r ans
    ans="${ans//$'\r'/}"          # 去除部分终端/粘贴带来的回车符，避免编号匹配失败
    [ -z "$ans" ] && ans="1"
    SEL_ENGINES=()
    local n
    for n in $(printf '%s' "$ans" | tr ',' ' '); do
        case "$n" in
            1) SEL_ENGINES+=("fw") ;;
            2) SEL_ENGINES+=("sv") ;;
            3) if [ "$arch" = "arm64" ]; then SEL_ENGINES+=("mlx"); else log_warn "MLX 仅 Apple Silicon 可用，已忽略"; fi ;;
            4) SEL_ENGINES+=("ds") ;;
            5) SEL_ENGINES+=("on") ;;
            6) SEL_ENGINES=("fw" "sv")
                if [ "$arch" = "arm64" ]; then SEL_ENGINES+=("mlx"); fi
                SEL_ENGINES+=("ds" "on")
                break ;;
            *) log_warn "忽略无效编号: $n" ;;
        esac
    done
    [ ${#SEL_ENGINES[@]} -gt 0 ] || SEL_ENGINES=("fw")
}

# 交互选择 LLM 文本后处理；结果写入 SEL_LLM(ollama|online|off)、OLLAMA_MODEL、LLM_PULL(0/1)
prompt_llm() {
    log_title "② 选择 LLM 文本后处理方式（润色/整理识别结果）"
    printf "  1) Ollama 本地大模型   离线润色；%s需本地 Ollama，模型大(默认 %s ~4.7GB)%s\n" "$YELLOW" "$OLLAMA_MODEL" "$NC" >&2
    printf "     如本地未安装默认模型，可执行：ollama pull %s; ollama list\n" "$OLLAMA_MODEL" >&2
    printf "  2) OpenAI 兼容在线     调用在线 API（需 API Key），%s无需下载%s\n" "$GREEN" "$NC" >&2
    printf "  3) 不启用              纯语音转写，不做润色（无任何下载）\n" >&2
    printf "%s请选择(1/2/3)，回车默认 3(不启用): %s" "$BOLD" "$NC" >&2
    local ans; read -r ans
    ans="${ans//$'\r'/}"
    [ -z "$ans" ] && ans="3"
    LLM_PULL=0
    case "$ans" in
        1)  SEL_LLM="ollama"
            printf "%s  Ollama 模型名(回车用默认 %s): %s" "$BOLD" "$OLLAMA_MODEL" "$NC" >&2
            local m; read -r m; m="${m//$'\r'/}"; [ -n "$m" ] && OLLAMA_MODEL="$m"
            printf "%s  现在就拉取该模型吗？体积较大(y/N): %s" "$BOLD" "$NC" >&2
            local p; read -r p; p="${p//$'\r'/}"
            case "$p" in y|Y|yes|YES) LLM_PULL=1 ;; *) LLM_PULL=0 ;; esac
            ;;
        2)  SEL_LLM="online" ;;
        *)  SEL_LLM="off" ;;
    esac
}

cmd_install() {
    log_title "Install / 按需安装（只装你选的引擎与模型）"
    ensure_dirs
    load_build_config "$DEFAULT_PROFILE"
    require_python
    detect_env   # 检测系统架构(Intel/ARM)、Python 架构与可用引擎
    local arch; arch="$(uname -m)"

    # 选择来源：有 TTY 则交互勾选；无 TTY(CI/管道) 退回 build-configuration 默认，且不自动拉 Ollama
    if [ -t 0 ]; then
        prompt_asr_engines "$arch"
        prompt_llm
    else
        log_warn "非交互环境(无 TTY)：按 build-configuration 默认引擎安装，且不自动拉取 Ollama 大模型。"
        case "${ASR_ENGINE:-whisper_local}" in
            sensevoice)   SEL_ENGINES=("sv") ;;
            mlx_whisper)  SEL_ENGINES=("mlx") ;;
            dashscope)    SEL_ENGINES=("ds") ;;
            online)       SEL_ENGINES=("on") ;;
            *)            SEL_ENGINES=("fw") ;;
        esac
        SEL_LLM="${LLM_MODE:-off}"
        LLM_PULL=0
    fi

    local primary; primary="$(engine_config_name "${SEL_ENGINES[0]}")"
    log_info "已选 ASR 引擎: ${SEL_ENGINES[*]}（主引擎=${primary}）；LLM: ${SEL_LLM}"

    # 1) pip 安装：base + 选中引擎组（去重）
    local req_args=(-r "$PROJECT_DIR/requirements/base.txt")
    local seen_files=" base "
    local k rf
    for k in "${SEL_ENGINES[@]}"; do
        rf="$(engine_req_file "$k")"
        [ -z "$rf" ] && continue
        case "$seen_files" in *" $rf "*) continue ;; esac
        seen_files="$seen_files$rf "
        req_args+=(-r "$PROJECT_DIR/$rf")
    done
    # pip 自身会跳过已安装的包（Requirement already satisfied），先做一次快速检查
    if "$PYTHON_BIN" -m pip install --dry-run --report /dev/null "${req_args[@]}" 2>/dev/null | grep -q "would install"; then
        log_info "pip 安装：基础依赖 + 选中引擎依赖…（SenseVoice 含 torch，体积较大请耐心）"
        "$PYTHON_BIN" -m pip install "${req_args[@]}" \
            || { log_error "依赖安装失败"; exit 3; }
    else
        log_info "pip 依赖已全部满足，跳过安装 ✓"
    fi

    # 2) 写应用配置：主引擎 + whisper 模型 + LLM 模式/模型
    LLM_MODE="$SEL_LLM"
    log_info "初始化应用配置（asr=${primary} whisper=${WHISPER_MODEL} llm=${LLM_MODE} ollama=${OLLAMA_MODEL}）…"
    ( cd "$PROJECT_DIR" && ASR_ENGINE="$primary" LLM_MODE="$LLM_MODE" \
        WHISPER_MODEL="$WHISPER_MODEL" OLLAMA_MODEL="$OLLAMA_MODEL" "$PYTHON_BIN" - <<'PY'
import os
from voiceinput.config import load_config, save_config
c = load_config()
c.asr.engine = os.environ["ASR_ENGINE"]
c.asr.whisper_model = os.environ["WHISPER_MODEL"]
c.llm.mode = os.environ["LLM_MODE"]
c.llm.ollama.model = os.environ["OLLAMA_MODEL"]
save_config(c)
print("应用配置已写入")
PY
) || log_warn "预置应用配置失败（首次启动时应用会自动生成默认配置）"

    # 3) 仅下载「选中的本地引擎」的语音模型（在线引擎跳过）
    local dl_engines=()
    for k in "${SEL_ENGINES[@]}"; do
        if engine_needs_model "$k"; then dl_engines+=("$(engine_config_name "$k")"); fi
    done
    if [ ${#dl_engines[@]} -gt 0 ]; then
        log_title "③ 下载选中本地引擎的语音模型: ${dl_engines[*]}"
        ( cd "$PROJECT_DIR" && VI_DL_ENGINES="${dl_engines[*]}" "$PYTHON_BIN" - <<'PY'
import os
from voiceinput.config import load_config
from voiceinput.asr import make_asr
base = load_config()
for eng in os.environ.get("VI_DL_ENGINES", "").split():
    try:
        c = load_config()
        c.asr.engine = eng
        print(f"  下载/加载 ASR 模型: {eng} …（首次较大，请耐心）")
        a = make_asr(c)
        if hasattr(a, "_ensure_model"):
            a._ensure_model()
        print(f"  ✓ {eng} 模型已就绪。")
    except Exception as e:
        print(f"  ! {eng} 预下载失败（首次使用时会自动重试）：{e}")
PY
) || log_warn "部分语音模型预下载失败（首次使用时会自动重试下载）"
    else
        log_info "所选均为在线引擎，无需下载本地语音模型。"
    fi

    # 4) 仅当选 Ollama 且用户明确同意时才拉取大模型（4.7GB）
    if [ "$SEL_LLM" = "ollama" ]; then
        if [ "$LLM_PULL" = "1" ]; then
            if command -v ollama >/dev/null 2>&1; then
                log_title "④ 拉取 Ollama 大模型: ${OLLAMA_MODEL}"
                ollama pull "${OLLAMA_MODEL}" || log_warn "ollama pull 失败（可稍后手动：ollama pull ${OLLAMA_MODEL}）"
            else
                log_warn "未找到 ollama 命令；请先安装 Ollama，再手动：ollama pull ${OLLAMA_MODEL}"
            fi
        else
            log_info "已选 Ollama 但未现在拉取。需要时手动执行：ollama pull ${OLLAMA_MODEL}"
        fi
    fi

    write_install_cfg
    log_info "安装完成。提示：首次启动后需在「系统设置→隐私与安全性」授予"
    log_info "  麦克风、辅助功能、输入监控 权限。使用 './install -s' 启动。"
}

cmd_uninstall() {
    log_title "Uninstall / 卸载（保留配置、数据与模型缓存）"
    cmd_stop || true
    # 取消开机自启（LaunchAgent），复用应用自身模块
    if [ -x "$PYTHON_BIN" ]; then
        ( cd "$PROJECT_DIR" && "$PYTHON_BIN" -c \
            "from voiceinput import autostart; autostart.disable()" 2>/dev/null ) || true
    fi
    log_info "已卸载（停止运行 + 取消开机自启）。配置/日志/模型缓存均保留。"
}

cmd_delete() {
    log_title "Delete / 彻底清除"
    log_warn "将删除：应用配置目录、应用日志、脚本运行日志、PID、.install.cfg、开机自启项。"
    log_warn "将保留：项目源码、Whisper 模型缓存（~/.cache，按你的选择保留）。"
    if ! confirm_yes "${YELLOW}请输入 'yes' 确认彻底清除：${NC}"; then
        log_warn "已取消"; exit 5
    fi
    cmd_uninstall || true
    safe_rm "$APP_SUPPORT_DIR"     # ~/Library/Application Support/VoiceInput
    safe_rm "$APP_LOG_DIR"         # ~/Library/Logs/VoiceInput
    safe_rm "$MAIN_LOG_FILE"
    safe_rm "$INSTALL_CFG_FILE"
    rm -f "$PID_FILE"
    log_info "已彻底清除（模型缓存与源码保留）。"
}

cmd_start() {
    log_title "Start / 启动（nohup 后台）"
    if is_running; then log_info "已在运行（PID $(cat "$PID_FILE")），跳过"; return 0; fi
    require_python
    ensure_dirs
    # 源码运行模式：不强制先 -i。只要依赖就绪（能导入 voiceinput + rumps）即可直跑；
    # 缺依赖才提示安装。-i 仅用于装 pip 依赖与预置应用配置。
    if ! ( cd "$PROJECT_DIR" && "$PYTHON_BIN" -c "import voiceinput, rumps" >/dev/null 2>&1 ); then
        log_error "依赖未就绪（无法 import voiceinput/rumps）。请先执行 './install -i' 安装依赖。"
        exit 3
    fi
    [ -f "$INSTALL_CFG_FILE" ] || log_warn "未执行过 -i：将用应用默认配置直跑（首次启动自动生成配置）。"
    # 清旧字节码：避免改了源码但 .pyc 未失效导致仍跑旧代码（曾因此漏掉新增方法）。
    find "$PROJECT_DIR/voiceinput" -name __pycache__ -type d -prune -exec rm -rf {} + 2>/dev/null || true
    log_info "nohup 后台启动 voiceinput…"
    ( cd "$PROJECT_DIR" && nohup "$PYTHON_BIN" -m voiceinput >> "$MAIN_LOG_FILE" 2>&1 & echo $! > "$PID_FILE" )
    sleep 1
    if is_running; then
        log_info "启动成功（PID $(cat "$PID_FILE")）。菜单栏应出现 🎙️ 图标。"
        log_info "若热键不可用，请授予 输入监控/辅助功能 权限后重启。"
    else
        log_error "启动失败，请查看日志：./install -l"
        exit 1
    fi
}

cmd_stop() {
    log_title "Stop / 停止"
    local killed=0

    # 1) PID 文件记录的进程
    if [ -f "$PID_FILE" ]; then
        local pid; pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            log_info "优雅停止 (TERM) PID ${pid}…"
            kill -TERM "$pid" 2>/dev/null || true
            killed=1
        fi
    fi

    # 2) 兜底：清理所有遗留 voiceinput 实例（含手动/重复启动、PID 文件丢失的）
    local pids; pids=$(voiceinput_pids)
    if [ -n "$pids" ]; then
        log_info "清理 voiceinput 实例: ${pids}"
        # shellcheck disable=SC2086
        kill -TERM $pids 2>/dev/null || true
        killed=1
    fi

    # 3) 等待退出，超时强杀
    local i=0
    while [ $i -lt 10 ] && [ -n "$(voiceinput_pids)" ]; do
        sleep 0.5; i=$((i+1))
    done
    pids=$(voiceinput_pids)
    if [ -n "$pids" ]; then
        log_warn "超时未退出，强制 kill -9: ${pids}"
        # shellcheck disable=SC2086
        kill -9 $pids 2>/dev/null || true
    fi

    rm -f "$PID_FILE"
    [ "$killed" = "1" ] && log_info "已停止" || log_info "未在运行"
}

cmd_restart() {
    cmd_stop || true
    cmd_start
}

cmd_status() {
    load_install_cfg
    printf "\n%s[Configuration]%s\n" "$BOLD" "$NC"
    printf "  Name:        %s\n" "$NAME"
    printf "  Profile:     %s\n" "$PROFILE"
    printf "  Python:      %s\n" "$PYTHON_BIN"
    printf "  Whisper模型:  %s\n" "$WHISPER_MODEL"
    printf "  LLM:         %s (ollama模型: %s)\n" "$LLM_MODE" "$OLLAMA_MODEL"
    printf "  配置目录:     %s\n" "$APP_SUPPORT_DIR"

    printf "\n%s[Runtime]%s\n" "$BOLD" "$NC"
    if is_running; then
        printf "  Status:  %sRUNNING%s (PID %s)\n" "$GREEN" "$NC" "$(cat "$PID_FILE")"
    elif [ -f "$INSTALL_CFG_FILE" ]; then
        printf "  Status:  %sSTOPPED%s\n" "$YELLOW" "$NC"
    else
        printf "  Status:  %sNOT_INSTALLED%s\n" "$RED" "$NC"
    fi

    printf "\n%s[依赖]%s\n" "$BOLD" "$NC"
    if ollama_reachable; then
        printf "  Ollama:  %s可用%s (localhost:11434)\n" "$GREEN" "$NC"
    else
        printf "  Ollama:  %s不可达%s（本地大模型整理不可用）\n" "$YELLOW" "$NC"
    fi
    # 开机自启状态
    if [ -f "$HOME/Library/LaunchAgents/com.voiceinput.agent.plist" ]; then
        printf "  开机自启: %s已启用%s\n" "$GREEN" "$NC"
    else
        printf "  开机自启: 未启用\n"
    fi
    # 模型缓存大小
    local cache="$HOME/.cache/huggingface"
    if [ -d "$cache" ]; then
        printf "  模型缓存: %s\n" "$(du -sh "$cache" 2>/dev/null | awk '{print $1}')"
    fi

    printf "\n%s[Recent log]%s\n" "$BOLD" "$NC"
    local logf=""
    for f in "$APP_LOG_FILE" "$MAIN_LOG_FILE" "$INSTALL_LOG"; do
        if [ -f "$f" ]; then logf="$f"; break; fi
    done
    if [ -n "$logf" ]; then tail -n 5 "$logf"; else printf "  (无日志)\n"; fi
}

cmd_log() {
    # 优先看应用结构化日志(详细链路)，无则回退 nohup 运行输出，再回退 install 操作日志
    local target=""
    for f in "$APP_LOG_FILE" "$MAIN_LOG_FILE" "$INSTALL_LOG"; do
        if [ -f "$f" ]; then target="$f"; break; fi
    done
    if [ -z "$target" ]; then log_error "无可查看日志"; exit 1; fi
    log_info "tail -f $target  （Ctrl+C 退出）"
    tail -f "$target"
}

cmd_benchmark() {
    # ASR 四引擎速度基准测试（输入同一段语音，多次取平均，找最快）
    local wav="${1:-}"
    log_title "Benchmark / ASR 引擎速度基准测试"
    load_build_config "$DEFAULT_PROFILE"
    require_python
    local bench="$PROJECT_DIR/scripts/asr_benchmark.py"
    [ -f "$bench" ] || { log_error "未找到 $bench"; exit 1; }
    local args=()
    [ -n "$wav" ] && args=(--wav "$wav")
    # bash 3.2 安全：空数组用 ${arr[@]+"${arr[@]}"} 展开
    ( cd "$PROJECT_DIR" && "$PYTHON_BIN" "$bench" ${args[@]+"${args[@]}"} ) \
        || { log_error "基准测试失败"; exit 1; }
}

cmd_help() {
    load_install_cfg
    cat <<EOF
install (VoiceInput) v${SCRIPT_VERSION}  (生成自 write-install-shell)

macOS AI 智能语音输入 —— Python 菜单栏桌面应用（从源码运行 + nohup 后台 + conda base）

用法：./install [选项 ...]

选项：
  -b                校验/构建（py_compile + pytest；使用 loc profile）
  -i                按需安装：交互勾选 ASR 引擎 + LLM 后处理，只装/只下载你选的（幂等）
                    无 TTY 时退回 build-configuration 默认引擎，且不自动拉取 Ollama 大模型
  -u                卸载（停止 + 取消开机自启；保留配置/数据/模型）
  -d                彻底清除（删配置/日志/自启项；保留源码与模型缓存；需输入 yes）
  -s                启动（nohup 后台）
  -k                停止
  -r                重启（= -k -s）
  -v                查看状态（配置/运行/Ollama/自启/模型缓存/日志）
  -l                查看运行日志（tail -f）
  -t asr [wav]      ASR 四引擎速度基准测试（同一段语音多次取平均，找最快；可选自定义 WAV）
  -p <port>         【保留，对本应用无效：本程序无监听端口】
  --port <port>     同 -p
  -h | --help | help | 无参数   显示本帮助

组合短参（按字符顺序执行）：
  -kbr  ≡  -k -b -r        -ibs  ≡  -i -b -s

当前默认值：
  Profile:     ${PROFILE}
  Python:      ${PYTHON_BIN}
  Whisper模型:  ${WHISPER_MODEL}
  LLM:         ${LLM_MODE} / ${OLLAMA_MODEL}
EOF
}

#===============================================================================
# 参数解析
#===============================================================================
ACTIONS=()

parse_args() {
    while [ $# -gt 0 ]; do
        local tok="$1"
        case "$tok" in
            "" | -h | --help | help)
                cmd_help; exit 0 ;;
            --port)
                shift; [ $# -gt 0 ] || { log_error "--port 需要一个值"; exit 2; }
                assert_port "$1"; PORT="$1"
                log_warn "本应用无监听端口，-p/--port 被忽略" ;;
            --port=*)
                local v="${tok#--port=}"; assert_port "$v"; PORT="$v"
                log_warn "本应用无监听端口，-p/--port 被忽略" ;;
            -p)
                shift; [ $# -gt 0 ] || { log_error "-p 需要一个值"; exit 2; }
                assert_port "$1"; PORT="$1"
                log_warn "本应用无监听端口，-p/--port 被忽略" ;;
            -b)
                ACTIONS+=("build:") ;;
            -t)
                # 测试套件：用法 -t asr [wav]（目前仅 asr：ASR 引擎速度基准）
                local twav=""
                # 可选测试类型 asr（缺省即 asr）
                if [ $# -ge 2 ] && [ "$2" = "asr" ]; then shift; fi
                # 可选自定义 wav 文件
                if [ $# -ge 2 ] && [[ "$2" != -* ]]; then twav="$2"; shift; fi
                ACTIONS+=("benchmark:$twav") ;;
            -*)
                local flags="${tok#-}"
                local i ch
                for ((i=0; i<${#flags}; i++)); do
                    ch="${flags:$i:1}"
                    case "$ch" in
                        h) cmd_help; exit 0 ;;
                        b) ACTIONS+=("build:") ;;
                        i) ACTIONS+=("install") ;;
                        u) ACTIONS+=("uninstall") ;;
                        d) ACTIONS+=("delete") ;;
                        s) ACTIONS+=("start") ;;
                        k) ACTIONS+=("stop") ;;
                        r) ACTIONS+=("restart") ;;
                        v) ACTIONS+=("status") ;;
                        l) ACTIONS+=("log") ;;
                        t) ACTIONS+=("benchmark:") ;;
                        p) log_error "组合短参中不能用 -p，请单独写: -p <port>"; exit 2 ;;
                        *) log_error "未知选项: -$ch"; exit 2 ;;
                    esac
                done ;;
            *)
                log_error "未知参数: $tok"; exit 2 ;;
        esac
        shift
    done
}

#===============================================================================
# 入口
#===============================================================================
main() {
    ensure_dirs
    load_install_cfg

    if [ $# -eq 0 ]; then cmd_help; exit 0; fi

    parse_args "$@"

    [ -f "$INSTALL_CFG_FILE" ] && write_install_cfg

    [ ${#ACTIONS[@]} -gt 0 ] || exit 0
    local act
    for act in "${ACTIONS[@]}"; do
        case "$act" in
            build:*)   cmd_build "${act#build:}" ;;
            install)   cmd_install ;;
            uninstall) cmd_uninstall ;;
            delete)    cmd_delete ;;
            start)     cmd_start ;;
            stop)      cmd_stop ;;
            restart)   cmd_restart ;;
            status)    cmd_status ;;
            log)       cmd_log ;;
            benchmark:*) cmd_benchmark "${act#benchmark:}" ;;
            *)         log_error "内部错误：未知动作 $act"; exit 1 ;;
        esac
    done
}

main "$@"
