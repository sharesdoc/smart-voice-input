#!/usr/bin/env bash
#===============================================================================
# startup-asr-server — 局域网 SenseVoice ASR HTTP 服务管理脚本
#
# 用途：在 Mac Studio 上把 SenseVoice 暴露为 OpenAI 兼容的 ASR HTTP 服务，
#       供同一局域网内的其他机器通过「在线 ASR」引擎调用。
#
# 用法：./startup-asr-server [-s|-k|-r] [-p PORT] [--language zh] [--device auto]
#===============================================================================
set -Euo pipefail

#───────────────────────────────────────────────────────────────────────────────
# 元数据
#───────────────────────────────────────────────────────────────────────────────
SCRIPT_VERSION="1.0.0"
NAME="asr-server"
DEFAULT_PORT=18765
DEFAULT_LANGUAGE="zh"
DEFAULT_DEVICE="auto"

#───────────────────────────────────────────────────────────────────────────────
# 路径
#───────────────────────────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$SCRIPT_DIR"
LOG_DIR="$PROJECT_DIR/log"
LOG_FILE="$LOG_DIR/asr-server.log"
PID_FILE="$PROJECT_DIR/.asr-server.pid"
SERVER_SCRIPT="$PROJECT_DIR/scripts/asr_server.py"

#───────────────────────────────────────────────────────────────────────────────
# 颜色（非 TTY 自动关闭）
#───────────────────────────────────────────────────────────────────────────────
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED=$(printf '\033[0;31m');   GREEN=$(printf '\033[0;32m')
    YELLOW=$(printf '\033[1;33m'); BLUE=$(printf '\033[0;34m')
    BOLD=$(printf '\033[1m');     NC=$(printf '\033[0m')
else
    RED=""; GREEN=""; YELLOW=""; BLUE=""; BOLD=""; NC=""
fi

log_info()  { printf "%s[INFO]%s %s\n"  "$GREEN"  "$NC" "$*"; }
log_warn()  { printf "%s[WARN]%s %s\n"  "$YELLOW" "$NC" "$*"; }
log_error() { printf "%s[ERROR]%s %s\n" "$RED"    "$NC" "$*" >&2; }
log_title() { printf "\n%s%s▶ %s%s\n"   "$BLUE" "$BOLD" "$*" "$NC"; }

#───────────────────────────────────────────────────────────────────────────────
# Python 检测
#───────────────────────────────────────────────────────────────────────────────
detect_python() {
    # 优先 conda base（与 voiceinput 主应用保持同一环境）
    for candidate in \
        "$HOME/ins/miniconda/bin/python" \
        "$HOME/miniconda3/bin/python"   \
        "$HOME/anaconda3/bin/python"    \
        "$(command -v python3 2>/dev/null)" \
        "$(command -v python  2>/dev/null)"; do
        [ -x "$candidate" ] || continue
        if "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)" 2>/dev/null; then
            echo "$candidate"
            return 0
        fi
    done
    log_error "未找到 Python 3.9+，请先安装 conda/miniconda 或系统 Python。"
    exit 1
}

PYTHON_BIN=""

#───────────────────────────────────────────────────────────────────────────────
# 依赖自动安装
#───────────────────────────────────────────────────────────────────────────────
auto_install_deps() {
    log_title "检查并安装依赖"

    local missing=()

    # HTTP 服务依赖
    for pkg in fastapi uvicorn python-multipart; do
        local import_name="${pkg//-/_}"   # python-multipart → python_multipart
        # fastapi/uvicorn 直接用包名 import
        if ! "$PYTHON_BIN" -c "import $import_name" 2>/dev/null; then
            missing+=("$pkg")
        fi
    done
    # multipart 的 import 名特殊：multipart
    if ! "$PYTHON_BIN" -c "import multipart" 2>/dev/null; then
        # 已在上面加过 python-multipart，避免重复
        [[ " ${missing[*]} " != *" python-multipart "* ]] && missing+=("python-multipart")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        log_info "安装缺失依赖：${missing[*]}"
        "$PYTHON_BIN" -m pip install "${missing[@]}" --quiet || {
            log_error "pip install 失败，请手动执行：pip install ${missing[*]}"
            exit 1
        }
        log_info "依赖安装完成 ✓"
    else
        log_info "HTTP 服务依赖已就绪 ✓"
    fi

    # 检查 SenseVoice 核心依赖（funasr + torch）
    if ! "$PYTHON_BIN" -c "import funasr" 2>/dev/null; then
        log_error "未找到 funasr（SenseVoice 引擎）。"
        log_error "请先在此机器上完成语音输入法安装（./install -i 并选择 SenseVoice 引擎）。"
        exit 1
    fi
    if ! "$PYTHON_BIN" -c "import torch" 2>/dev/null; then
        log_error "未找到 torch（SenseVoice 依赖）。"
        log_error "请先运行：pip install torch torchaudio"
        exit 1
    fi
    log_info "SenseVoice 核心依赖 (funasr/torch) 已就绪 ✓"

    # 检查项目 voiceinput 包可导入
    if ! ( cd "$PROJECT_DIR" && "$PYTHON_BIN" -c "import voiceinput.asr" ) 2>/dev/null; then
        log_error "无法导入 voiceinput.asr，请确认脚本在项目根目录运行。"
        exit 1
    fi
    log_info "voiceinput 包可导入 ✓"
}

#───────────────────────────────────────────────────────────────────────────────
# 进程管理
#───────────────────────────────────────────────────────────────────────────────
is_running() {
    [ -f "$PID_FILE" ] || return 1
    local pid; pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    kill -0 "$pid" 2>/dev/null
}

get_pid() {
    [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || echo ""
}

get_local_ips() {
    # 列出所有局域网 IP（排除 127.x）
    ifconfig 2>/dev/null \
        | awk '/inet / && !/127\.0\.0\.1/{print $2}' \
        | grep -v '^$' \
        | tr '\n' '  ' || true
}

#───────────────────────────────────────────────────────────────────────────────
# 命令
#───────────────────────────────────────────────────────────────────────────────
cmd_start() {
    log_title "Start / 启动 ASR 服务"
    if is_running; then
        log_info "服务已在运行（PID $(get_pid)），跳过。如需重启请用 -r。"
        return 0
    fi

    PYTHON_BIN="$(detect_python)"
    log_info "Python: $PYTHON_BIN"
    auto_install_deps

    mkdir -p "$LOG_DIR"
    # 清旧字节码，避免改了源码但 .pyc 未失效
    find "$PROJECT_DIR/voiceinput" -name __pycache__ -type d -prune \
         -exec rm -rf {} + 2>/dev/null || true

    log_info "启动 ASR 服务（nohup 后台）…"
    ( cd "$PROJECT_DIR" && nohup "$PYTHON_BIN" scripts/asr_server.py \
          --port "$PORT" \
          --language "$LANGUAGE" \
          --device "$DEVICE" \
          >> "$LOG_FILE" 2>&1 & echo $! > "$PID_FILE" )

    sleep 2
    if is_running; then
        local ips; ips=$(get_local_ips)
        log_info "服务已启动（PID $(get_pid)） ✓"
        log_info "本机 IP：${ips:-（请手动查看）}"
        log_info "客户端 Base URL：http://<本机IP>:${PORT}/v1"
        log_info "健康检查：curl http://127.0.0.1:${PORT}/health"
        log_info "日志：$LOG_FILE"
    else
        log_error "服务启动失败，查看日志：$LOG_FILE"
        tail -20 "$LOG_FILE" 2>/dev/null || true
        exit 1
    fi
}

cmd_stop() {
    log_title "Stop / 停止 ASR 服务"
    if ! is_running; then
        log_info "服务未在运行。"
        rm -f "$PID_FILE"
        return 0
    fi
    local pid; pid=$(get_pid)
    log_info "发送 TERM 信号（PID $pid）…"
    kill -TERM "$pid" 2>/dev/null || true
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
        sleep 0.5; ((i++))
    done
    if kill -0 "$pid" 2>/dev/null; then
        log_warn "TERM 无效，强制 KILL…"
        kill -KILL "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
    log_info "已停止 ✓"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    log_title "Status / 状态"
    if is_running; then
        local pid; pid=$(get_pid)
        log_info "运行中（PID $pid）"
        log_info "端口：$PORT  语言：$LANGUAGE  设备：$DEVICE"
        local ips; ips=$(get_local_ips)
        log_info "局域网 IP：${ips:-（请手动查看）}"
        log_info "健康检查：curl http://127.0.0.1:${PORT}/health"
    else
        log_warn "未运行"
    fi
}

cmd_log() {
    if [ -f "$LOG_FILE" ]; then
        tail -50 "$LOG_FILE"
    else
        log_warn "日志文件不存在：$LOG_FILE"
    fi
}

#───────────────────────────────────────────────────────────────────────────────
# 帮助
#───────────────────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
${BOLD}startup-asr-server${NC} v${SCRIPT_VERSION} — 局域网 SenseVoice ASR HTTP 服务

${BOLD}用法${NC}
  ./startup-asr-server [选项 ...] <动作>

${BOLD}动作${NC}
  -s, --start      启动服务（自动安装缺失依赖）
  -k, --stop       停止服务
  -r, --restart    重启服务
      --status     查看运行状态
  -l, --log        查看最近日志（tail -50）
  -h, --help       显示此帮助

${BOLD}选项${NC}
  -p, --port PORT        监听端口（默认 ${DEFAULT_PORT}）
  --language LANG        识别语言：zh / en / auto（默认 ${DEFAULT_LANGUAGE}）
  --device DEVICE        推理设备：auto / mps / cpu（默认 ${DEFAULT_DEVICE}）
                         Apple Silicon 选 auto 会自动用 MPS 加速

${BOLD}示例${NC}
  ./startup-asr-server -s                     # 默认端口 ${DEFAULT_PORT} 启动
  ./startup-asr-server -s -p 9000             # 指定端口
  ./startup-asr-server -s --language auto     # 自动识别语言
  ./startup-asr-server -k                     # 停止
  ./startup-asr-server -r -p 9000             # 重启并换端口
  ./startup-asr-server --status               # 查看状态

${BOLD}客户端（另一台 Mac）配置${NC}
  设置 → 语音识别 → 引擎：在线 ASR
  在线 BaseURL : http://<本机局域网IP>:${DEFAULT_PORT}/v1
  在线模型    : SenseVoiceSmall
  API Key    : （留空）

${BOLD}日志${NC}
  $LOG_FILE
EOF
}

#───────────────────────────────────────────────────────────────────────────────
# 参数解析
#───────────────────────────────────────────────────────────────────────────────
ACTIONS=()
PORT="$DEFAULT_PORT"
LANGUAGE="$DEFAULT_LANGUAGE"
DEVICE="$DEFAULT_DEVICE"

if [ $# -eq 0 ]; then
    usage; exit 0
fi

while [ $# -gt 0 ]; do
    case "$1" in
        -s|--start)   ACTIONS+=("start");   shift ;;
        -k|--stop)    ACTIONS+=("stop");    shift ;;
        -r|--restart) ACTIONS+=("restart"); shift ;;
        --status)     ACTIONS+=("status");  shift ;;
        -l|--log)     ACTIONS+=("log");     shift ;;
        -h|--help)    usage; exit 0 ;;
        -p|--port)
            PORT="${2:?"--port 需要一个端口号"}"; shift 2 ;;
        --port=*)
            PORT="${1#--port=}"; shift ;;
        --language)
            LANGUAGE="${2:?"--language 需要参数"}"; shift 2 ;;
        --language=*)
            LANGUAGE="${1#--language=}"; shift ;;
        --device)
            DEVICE="${2:?"--device 需要参数"}"; shift 2 ;;
        --device=*)
            DEVICE="${1#--device=}"; shift ;;
        *)
            log_error "未知选项：$1  （用 -h 查看帮助）"; exit 1 ;;
    esac
done

if [ ${#ACTIONS[@]} -eq 0 ]; then
    usage; exit 0
fi

#───────────────────────────────────────────────────────────────────────────────
# 执行
#───────────────────────────────────────────────────────────────────────────────
for action in "${ACTIONS[@]}"; do
    case "$action" in
        start)   cmd_start   ;;
        stop)    cmd_stop    ;;
        restart) cmd_restart ;;
        status)  cmd_status  ;;
        log)     cmd_log     ;;
    esac
done
